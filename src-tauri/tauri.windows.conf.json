{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DaProd Editor Video",
        "url": "app/index.html",
        "width": 1600,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "backgroundColor": "#09080d",
        "dragDropEnabled": true,
        "theme": "Light",
        "decorations": false,
        "additionalBrowserArgs": "--force_high_performance_gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaFoundationD3D11VideoCapture --use-fake-ui-for-media-stream --auto-select-desktop-capture-source=Schermo"
      }
    ]
  }
}
